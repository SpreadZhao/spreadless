From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:28:49 +0800
Subject: [PATCH] temperature/cpu-temp: add CPU temperature component with
 sensor discovery

---
 components/temperature.c | 59 ++++++++++++++++++++++++++++++++++++++++
 config.def.h             |  4 +++
 slstatus.h               |  2 ++
 3 files changed, 65 insertions(+)

diff --git a/components/temperature.c b/components/temperature.c
index 7cf1394..2645e42 100644
--- a/components/temperature.c
+++ b/components/temperature.c
@@ -6,7 +6,66 @@
 
 
 #if defined(__linux__)
+	#include <glob.h>
+	#include <limits.h>
 	#include <stdint.h>
+	#include <string.h>
+	#include <unistd.h>
+
+	const char *
+	cpu_temp(const char *file)
+	{
+		static const char *drivers[] = { "coretemp", "k10temp", "zenpower", "cpu_thermal" };
+		static const char *icons[] = { "", "", "", "", "" };
+		static char path[PATH_MAX];
+		glob_t sensors = {0};
+		char name[64], trailing;
+		intmax_t millidegrees, degrees, level, remainder;
+		const char *color;
+		size_t i, j;
+
+		if (!file && !path[0]) {
+			if (glob("/sys/class/hwmon/hwmon*", 0, NULL, &sensors) != 0) {
+				globfree(&sensors);
+				return NULL;
+			}
+			for (i = 0; i < sensors.gl_pathc; i++) {
+				if (esnprintf(path, sizeof(path), "%s/name", sensors.gl_pathv[i]) < 0 ||
+				    pscanf(path, "%63s", name) != 1)
+					continue;
+				for (j = 0; j < LEN(drivers); j++)
+					if (!strcmp(name, drivers[j]))
+						break;
+				if (j < LEN(drivers) &&
+				    esnprintf(path, sizeof(path), "%s/temp1_input", sensors.gl_pathv[i]) >= 0 &&
+				    access(path, R_OK) == 0)
+					break;
+			}
+			if (i == sensors.gl_pathc)
+				path[0] = '\0';
+			globfree(&sensors);
+		}
+		if (!file)
+			file = path;
+		if (!file[0] || pscanf(file, "%jd %c", &millidegrees, &trailing) != 1) {
+			path[0] = '\0';
+			return NULL;
+		}
+		degrees = millidegrees / 1000;
+		remainder = millidegrees % 1000;
+		if (remainder >= 500)
+			degrees++;
+		else if (remainder <= -500)
+			degrees--;
+		level = degrees / 20;
+		if (level < 0)
+			level = 0;
+		if (level > 4)
+			level = 4;
+		color = degrees >= 80 ? temp_colors[2] :
+		        degrees >= 60 ? temp_colors[1] : temp_colors[0];
+		return bprintf("^fg(%s)%jd%s^fg()", color, degrees, icons[level]);
+	}
 
 	const char *
 	temp(const char *file)
diff --git a/config.def.h b/config.def.h
index 175ad17..cc61717 100644
--- a/config.def.h
+++ b/config.def.h
@@ -6,6 +6,9 @@ const unsigned int interval = 1000;
 /* text to show if no value can be retrieved */
 static const char unknown_str[] = "n/a";
 
+/* temperature colors: normal, warning (>= 60C), critical (>= 80C) */
+const char *const temp_colors[3] = { "6a9955", "e6e6aa", "ff0000" };
+
 /* maximum output string length */
 #define MAXLEN 2048
 
@@ -21,6 +24,7 @@ static const char unknown_str[] = "n/a";
  *                                                     NULL on OpenBSD/FreeBSD
  * cat                 read arbitrary file             path
  * cpu_freq            cpu frequency in MHz            NULL
+ * cpu_temp            colored CPU temperature icon    sensor path or NULL
  * cpu_perc            cpu usage in percent            NULL
  * datetime            date and time                   format string (%F %T)
  * disk_free           free disk space in GB           mountpoint path (/)
diff --git a/slstatus.h b/slstatus.h
index 65aba87..9349449 100644
--- a/slstatus.h
+++ b/slstatus.h
@@ -68,6 +68,8 @@ const char *swap_total(const char *unused);
 const char *swap_used(const char *unused);
 
 /* temperature */
+extern const char *const temp_colors[3];
+const char *cpu_temp(const char *file);
 const char *temp(const char *);
 
 /* uptime */
