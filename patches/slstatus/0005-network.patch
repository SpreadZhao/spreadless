From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:28:49 +0800
Subject: [PATCH] feat(network): show icons for a configured interface

Check carrier state and reuse upstream ipv4 and ipv6 address checks.
Show wired, Wi-Fi or disconnected icons for the configured interface.
---
 Makefile             |  1 +
 components/network.c | 23 +++++++++++++++++++++++
 config.h             |  1 +
 slstatus.h           |  3 +++
 4 files changed, 28 insertions(+)
 create mode 100644 components/network.c

diff --git a/Makefile b/Makefile
index 7a18274..f4ba8b1 100644
--- a/Makefile
+++ b/Makefile
@@ -19,6 +19,7 @@ COM =\
 	components/keymap\
 	components/load_avg\
 	components/netspeeds\
+	components/network\
 	components/num_files\
 	components/ram\
 	components/run_command\
diff --git a/components/network.c b/components/network.c
new file mode 100644
index 0000000..68ed090
--- /dev/null
+++ b/components/network.c
@@ -0,0 +1,23 @@
+/* See LICENSE file for copyright and license details. */
+#include <limits.h>
+#include <unistd.h>
+
+#include "../slstatus.h"
+#include "../util.h"
+
+const char *
+network_icon(const char *interface)
+{
+	char path[PATH_MAX];
+	int carrier;
+
+	if (!interface ||
+	    esnprintf(path, sizeof(path), "/sys/class/net/%s/carrier", interface) < 0)
+		return NULL;
+	if (pscanf(path, "%d", &carrier) != 1 || !carrier ||
+	    (!ipv4(interface) && !ipv6(interface)))
+		return "󰯡";
+	if (esnprintf(path, sizeof(path), "/sys/class/net/%s/wireless", interface) < 0)
+		return NULL;
+	return access(path, F_OK) == 0 ? "" : "󰈀";
+}
diff --git a/config.h b/config.h
index c72631d..0f64733 100644
--- a/config.h
+++ b/config.h
@@ -41,6 +41,7 @@ static const char unknown_str[] = "-";
  * load_avg            load average                    NULL
  * netspeed_rx         receive network speed           interface name (wlan0)
  * netspeed_tx         transfer network speed          interface name (wlan0)
+ * network_icon        wired/Wi-Fi/disconnected icon   interface name (eth0)
  * num_files           number of files in a directory  path
  *                                                     (/home/foo/Inbox/cur)
  * ram_free            free memory in GB               NULL
diff --git a/slstatus.h b/slstatus.h
index f385e50..e722cfa 100644
--- a/slstatus.h
+++ b/slstatus.h
@@ -85,3 +85,6 @@ const char *vol_perc(const char *card);
 /* wifi */
 const char *wifi_essid(const char *interface);
 const char *wifi_perc(const char *interface);
+
+/* network icon (Linux) */
+const char *network_icon(const char *interface);
