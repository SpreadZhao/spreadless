--- /dev/null
+++ b/components/network.c
@@ -0,0 +1,134 @@
+/* See LICENSE file for copyright and license details. */
+#include <errno.h>
+#include <limits.h>
+#include <net/if.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <linux/rtnetlink.h>
+
+#include "../slstatus.h"
+#include "../util.h"
+
+/* -1 skips a route; 0 selects a default without an interface; 1 finds one. */
+static int
+default_interface(const struct nlmsghdr *message, int family, char *name)
+{
+	const struct rtmsg *route;
+	const struct rtattr *attribute;
+	const struct rtnexthop *hop;
+	uint32_t table;
+	int index = 0, multipath_index = 0, remaining, hops;
+
+	if (message->nlmsg_len < NLMSG_LENGTH(sizeof(*route)))
+		return -1;
+	route = NLMSG_DATA(message);
+	if (route->rtm_family != family || route->rtm_dst_len != 0 ||
+	    (route->rtm_flags & RTM_F_CLONED))
+		return -1;
+	table = route->rtm_table;
+	remaining = RTM_PAYLOAD(message);
+	for (attribute = RTM_RTA(route); RTA_OK(attribute, remaining);
+	     attribute = RTA_NEXT(attribute, remaining)) {
+		if (attribute->rta_type == RTA_TABLE && RTA_PAYLOAD(attribute) >= sizeof(table))
+			memcpy(&table, RTA_DATA(attribute), sizeof(table));
+		else if (attribute->rta_type == RTA_OIF && RTA_PAYLOAD(attribute) >= sizeof(index))
+			memcpy(&index, RTA_DATA(attribute), sizeof(index));
+		else if (attribute->rta_type == RTA_MULTIPATH) {
+			hops = RTA_PAYLOAD(attribute);
+			for (hop = RTA_DATA(attribute); RTNH_OK(hop, hops); hop = RTNH_NEXT(hop)) {
+				if (!multipath_index && hop->rtnh_ifindex > 0)
+					multipath_index = hop->rtnh_ifindex;
+				hops -= RTNH_ALIGN(hop->rtnh_len);
+			}
+		}
+	}
+	if (table != RT_TABLE_MAIN)
+		return -1;
+	if (!index)
+		index = multipath_index;
+	if (index <= 0 || !if_indextoname((unsigned int)index, name))
+		return 0;
+	return 1;
+}
+
+static int
+route_interface(int family, char *name)
+{
+	struct {
+		struct nlmsghdr header;
+		struct rtmsg route;
+	} request;
+	struct sockaddr_nl kernel = { .nl_family = AF_NETLINK };
+	struct timeval timeout = { .tv_sec = 1 };
+	union {
+		struct nlmsghdr alignment;
+		char data[32768];
+	} buffer;
+	struct iovec vector = { .iov_base = buffer.data, .iov_len = sizeof(buffer.data) };
+	struct msghdr response;
+	struct sockaddr_nl sender;
+	struct nlmsghdr *message;
+	ssize_t length;
+	int fd, remaining, result = 0, selected;
+
+	fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+	if (fd < 0)
+		return 0;
+	if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) < 0 ||
+	    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) < 0)
+		goto out;
+	memset(&request, 0, sizeof(request));
+	request.header.nlmsg_len = NLMSG_LENGTH(sizeof(request.route));
+	request.header.nlmsg_type = RTM_GETROUTE;
+	request.header.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+	request.header.nlmsg_seq = 1;
+	request.route.rtm_family = family;
+	request.route.rtm_table = RT_TABLE_MAIN;
+	if (sendto(fd, &request, request.header.nlmsg_len, 0,
+	           (struct sockaddr *)&kernel, sizeof(kernel)) < 0)
+		goto out;
+	for (;;) {
+		memset(&response, 0, sizeof(response));
+		response.msg_name = &sender;
+		response.msg_namelen = sizeof(sender);
+		response.msg_iov = &vector;
+		response.msg_iovlen = 1;
+		length = recvmsg(fd, &response, 0);
+		if (length <= 0 || (response.msg_flags & MSG_TRUNC) || sender.nl_pid != 0)
+			goto out;
+		remaining = length;
+		for (message = (struct nlmsghdr *)buffer.data; NLMSG_OK(message, remaining);
+		     message = NLMSG_NEXT(message, remaining)) {
+			if (message->nlmsg_seq != request.header.nlmsg_seq)
+				continue;
+			if (message->nlmsg_type == NLMSG_DONE || message->nlmsg_type == NLMSG_ERROR)
+				goto out;
+			if (message->nlmsg_type != RTM_NEWROUTE)
+				continue;
+			selected = default_interface(message, family, name);
+			if (selected >= 0) {
+				result = selected;
+				goto out;
+			}
+		}
+	}
+out:
+	close(fd);
+	return result;
+}
+
+const char *
+network_icon(const char *unused)
+{
+	char name[IF_NAMESIZE], path[PATH_MAX];
+
+	if (!route_interface(AF_INET, name) && !route_interface(AF_INET6, name))
+		return "󰯡";
+	if (esnprintf(path, sizeof(path), "/sys/class/net/%s/wireless", name) < 0)
+		return NULL;
+	return access(path, F_OK) == 0 ? "" : "󰈀";
+}
diff --git a/config.h b/config.h
index a10fdaa..5f89835 100644
--- a/config.h
+++ b/config.h
@@ -41,6 +41,7 @@ static const char unknown_str[] = "-";
