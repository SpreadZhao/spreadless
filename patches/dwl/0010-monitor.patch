+/* Adapted from restore-monitor by Eldar Yusupov and 6z7y:
+ * https://codeberg.org/dwl/dwl-patches/src/branch/main/patches/restore-monitor */
+void
+restoremon(Monitor *m)
+{
+	Client *c;
+	struct wlr_box geom;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!c->restoring || !c->output || strcmp(c->output, m->wlr_output->name))
+			continue;
+		m->tagset[m->seltags] = c->restoreview;
+		migratemon(c, m, c->tags);
+		if (c->isfloating && !c->isfullscreen) {
+			geom = c->floatgeom;
+			geom.x += m->m.x;
+			geom.y += m->m.y;
+			resize(c, geom, 0);
+		}
+		c->prev = c->prevgeom;
+		c->prev.x += m->m.x;
+		c->prev.y += m->m.y;
+		c->restoring = 0;
+	}
+}
+
+void
+setmon(Client *c, Monitor *m, uint32_t newtags)
+{
+	free(c->output);
+	c->output = NULL;
+	if (m && !(c->output = strdup(m->wlr_output->name)))
+		die("strdup:");
+	c->restoring = 0;
+	migratemon(c, m, newtags);
+}
