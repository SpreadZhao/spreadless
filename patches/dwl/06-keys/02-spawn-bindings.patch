From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] keys/spawn-bindings: configure desktop application and media
 bindings

---
 config.h | 28 ++++++++++++++++++++++++----
 dwl.1    | 38 +++++++++++++++++++++++++++++++++++++-
 2 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/config.h b/config.h
index 9ab34c7..55f867e 100644
--- a/config.h
+++ b/config.h
@@ -162,16 +162,36 @@ static const double mouse_accel_speed = 0.0;
 	{ MODKEY|WLR_MODIFIER_SHIFT, KEY,            tag,             {.ui = 1 << TAG} }, \
 	{ MODKEY|WLR_MODIFIER_CTRL|WLR_MODIFIER_SHIFT,KEY,toggletag,  {.ui = 1 << TAG} }
 
+/* helper for spawning shell commands in the pre dwm-5.0 fashion */
+#define SHCMD(cmd) { .v = (const char*[]){ "/bin/sh", "-c", cmd, NULL } }
 
 /* commands */
-static const char *termcmd[] = { "foot", NULL };
-static const char *menucmd[] = { "wmenu-run", NULL };
+static const char *termcmd[] = { "footclient", NULL };
+static const char *menucmd[] = { "fuzzel", NULL };
 
 static const Key keys[] = {
 	/* modifier                                    key                            function          argument */
-	{ MODKEY,                                      XKB_KEY_p,                     spawn,            {.v = menucmd} },
-	{ MODKEY|WLR_MODIFIER_SHIFT,                   XKB_KEY_Return,                spawn,            {.v = termcmd} },
+	/* --- Applications & External Scripts --- */
+	{ MODKEY,                                      XKB_KEY_Return,                spawn,            {.v = termcmd} },
+	{ MODKEY|WLR_MODIFIER_SHIFT,                   XKB_KEY_Return,                spawn,            SHCMD("footclient -a dropdown-foot") },
+	{ MODKEY,                                      XKB_KEY_space,                 spawn,            {.v = menucmd} },
 	{ MODKEY,                                      XKB_KEY_b,                     togglebar,        {0} },
+	{ MODKEY|WLR_MODIFIER_SHIFT,                   XKB_KEY_l,                     spawn,            SHCMD("swaylock") },
+	{ MODKEY|WLR_MODIFIER_CTRL|WLR_MODIFIER_SHIFT, XKB_KEY_l,                     spawn,            SHCMD("\"${SCRIPT_HOME:-$HOME/scripts}/dwl/dwl_lock.sh\"") },
+	{ MODKEY|WLR_MODIFIER_SHIFT,                   XKB_KEY_a,                     spawn,            SHCMD("\"${SCRIPT_HOME:-$HOME/scripts}/util/screenshot.sh\"") },
+	{ MODKEY|WLR_MODIFIER_CTRL|WLR_MODIFIER_SHIFT, XKB_KEY_a,                     spawn,            SHCMD("\"${SCRIPT_HOME:-$HOME/scripts}/util/screenshot.sh\" -o") },
+	{ MODKEY|WLR_MODIFIER_SHIFT,                   XKB_KEY_v,                     spawn,            SHCMD("\"${SCRIPT_HOME:-$HOME/scripts}/util/clipboard_history.sh\"") },
+	{ MODKEY,                                      XKB_KEY_t,                     spawn,            SHCMD("\"${SCRIPT_HOME:-$HOME/scripts}/dwl/tray.sh\"") },
+	{ MODKEY|WLR_MODIFIER_CTRL|WLR_MODIFIER_SHIFT, XKB_KEY_n,                     spawn,            SHCMD("notification-history browse") },
+	{ MODKEY,                                      XKB_KEY_z,                     spawn,            SHCMD("shmooz") },
+
+	/* --- Media & Hardware Keys --- */
+	{ 0,                                           XKB_KEY_XF86AudioRaiseVolume,  spawn,            SHCMD("wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0") },
+	{ 0,                                           XKB_KEY_XF86AudioLowerVolume,  spawn,            SHCMD("wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-") },
+	{ 0,                                           XKB_KEY_XF86AudioMute,         spawn,            SHCMD("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle") },
+	{ 0,                                           XKB_KEY_XF86AudioMicMute,      spawn,            SHCMD("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle") },
+	{ 0,                                           XKB_KEY_XF86MonBrightnessUp,   spawn,            SHCMD("brightnessctl --class=backlight set +10%") },
+	{ 0,                                           XKB_KEY_XF86MonBrightnessDown, spawn,            SHCMD("brightnessctl --class=backlight set 10%-") },
 
 	/* --- Window Focus & Stack Management (Native dwl) --- */
 	{ MODKEY,                                      XKB_KEY_j,                     focusstack,       {.i = +1} },
diff --git a/dwl.1 b/dwl.1
index 193c1bd..8c951ba 100644
--- a/dwl.1
+++ b/dwl.1
@@ -54,6 +54,16 @@ Toggle a tag in the current view.
 Assign the focused window to a single tag.
 .It Mod-Ctrl-Shift-[1-9]
 Toggle the focused window's membership in a tag.
+.It Mod-Return
+Open a terminal with
+.Xr footclient 1 .
+.It Mod-Shift-Return
+Open a Foot client with the app ID
+.Li dropdown-foot .
+.It Mod-Space
+Open the
+.Xr fuzzel 1
+application launcher.
 .It Mod-[jk]
 Focus the next or previous window.
 .It Mod-[id]
@@ -77,6 +87,25 @@ Toggle fullscreen for the focused window.
 Toggle floating for the focused window.
 .It Mod-b
 Show or hide the status bar on the selected output.
+.It Mod-Shift-l
+Lock the session with
+.Xr swaylock 1 .
+.It Mod-Ctrl-Shift-l
+Run the dwl lock script to lock the session and turn off displays.
+.It Mod-Shift-a
+Run the screenshot script.
+.It Mod-Ctrl-Shift-a
+Run the screenshot script with
+.Fl o .
+.It Mod-Shift-v
+Open clipboard history.
+.It Mod-t
+Open the system tray menu.
+.It Mod-Ctrl-Shift-n
+Open notification history.
+.It Mod-z
+Launch shmooz.
+.It Mod-0
 View all tags.
 .It Mod-Shift-0
 Assign the focused window to all tags.
@@ -91,6 +120,8 @@ Quit
 Switch to the corresponding Linux virtual terminal.
 .El
 .Pp
+Dedicated audio keys adjust volume and toggle speaker or microphone mute.
+Dedicated backlight keys adjust display brightness.
 Key names may differ depending on the keyboard layout.
 .Ss Mouse commands
 .Bl -tag -width 24n -offset indent -compact
@@ -144,6 +175,11 @@ Various variables specific to wlroots.
 Various variables specific to libxkbcommon.
 .It Ev XCURSOR_PATH
 List of directories to search for XCursor themes in.
+.It Ev SCRIPT_HOME
+Directory containing the screenshot, clipboard-history, tray and dwl lock scripts.
+Defaults to
+.Pa $HOME/scripts .
+.It Ev HOME
 A directory where there are always dear files there for you.
 Waiting for you to clean them up.
 .El
@@ -173,7 +209,7 @@ Supply status text from
 .Sh SEE ALSO
 .Xr dwm 1 ,
 .Xr foot 1 ,
-.Xr wmenu 1 ,
+.Xr fuzzel 1 ,
 .Xr xkeyboard-config 7
 .Sh BUGS
 All of them.
