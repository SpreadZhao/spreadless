 README.md    |  36 ++--
 config.def.h |  33 +++-
 drwl.h       | 310 ++++++++++++++++++++++++++++++++
 dwl.1        | 112 ++----------
 dwl.c        | 497 ++++++++++++++++++++++++++++++++++++++++++---------
 util.h       |  17 --
 7 files changed, 770 insertions(+), 237 deletions(-)
 create mode 100644 drwl.h

