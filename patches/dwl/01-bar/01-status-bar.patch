+int
+statusfeed(const char *text, size_t length)
+{
+	static char line[sizeof(stext)];
+	static size_t used;
+	static int discard;
+	size_t i;
+	int changed = 0;
+
+	for (i = 0; i < length; i++) {
+		if (text[i] == '\n') {
+			if (!discard) {
+				line[used] = '\0';
+				memcpy(stext, line, used + 1);
+				changed = 1;
+			}
+			used = 0;
+			discard = 0;
+		} else if (!discard) {
+			if (text[i] == '\0' || used == sizeof(line) - 1) {
+				discard = 1;
+				used = 0;
+			} else {
+				line[used++] = text[i];
+			}
+		}
+	}
+	return changed;
+}
+
+int
+statuswidth(Monitor *m)
+{
+	return (int)drwl_font_getwidth(m->drw, stext) + m->statuspad;
+}
+
+int
+statusin(int fd, unsigned int mask, void *data)
+{
+	char status[sizeof(stext)];
+	ssize_t n;
+
+	if (mask & WL_EVENT_ERROR) {
+		wl_event_source_remove(status_event_source);
+		return 0;
+	}
+
+	do {
+		n = read(fd, status, sizeof(status) - 1);
+	} while (n < 0 && errno == EINTR);
+	if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+		return 0;
+	if (n <= 0) {
+		wl_event_source_remove(status_event_source);
+		return 0;
+	}
+
+	if (statusfeed(status, (size_t)n))
+		drawbars();
+
+	return 0;
+}
