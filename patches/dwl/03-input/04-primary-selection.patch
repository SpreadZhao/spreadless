From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] input/primary-selection: allow disabling primary selection

---
 config.def.h | 1 +
 dwl.c        | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/config.def.h b/config.def.h
index a6a3bde..2cc595d 100644
--- a/config.def.h
+++ b/config.def.h
@@ -9,6 +9,7 @@ static const int bypass_surface_visibility = 0;  /* 1 means idle inhibitors will
 static const unsigned int borderpx         = 2; /* visible border width when focused */
 static const unsigned int unfocused_borderpx = 0;
 static const unsigned int snap             = 32; /* snap pixel */
+static const int enable_primary_selection  = 0;  /* 0 disables middle-click primary selection */
 static const int showbar                   = 1; /* 0 means no bar */
 static const int topbar                    = 1; /* 0 means bottom bar */
 static const int bar_hpad                  = 2;
diff --git a/dwl.c b/dwl.c
index b2b6768..a9830ed 100644
--- a/dwl.c
+++ b/dwl.c
@@ -2890,6 +2890,8 @@ setpsel(struct wl_listener *listener, void *data)
 	 * ignore such requests if they so choose, but in dwl we always honor them
 	 */
 	struct wlr_seat_request_set_primary_selection_event *event = data;
+	if (!enable_primary_selection)
+		return;
 	wlr_seat_set_primary_selection(seat, event->source, event->serial);
 }
 
