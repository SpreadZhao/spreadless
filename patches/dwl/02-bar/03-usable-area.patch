From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] bar/usable-area: update bar geometry before arranging layers

Refresh bar dimensions at the start of updatemons() before arrangelayers()
reserves usable area for client windows.
---
 dwl.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/dwl.c b/dwl.c
index bdc8adf..12db97f 100644
--- a/dwl.c
+++ b/dwl.c
@@ -3421,6 +3421,8 @@ updatemons(struct wl_listener *listener, void *data)
 	wlr_scene_rect_set_size(locked_bg, sgeom.width, sgeom.height);
 
 	wl_list_for_each(m, &mons, link) {
+		/* Restore bar geometry before reserving space for clients. */
+		updatebar(m);
 		if (!m->wlr_output->enabled)
 			continue;
 		config_head = wlr_output_configuration_head_v1_create(config, m->wlr_output);
@@ -3474,10 +3476,7 @@ updatemons(struct wl_listener *listener, void *data)
 
 	if (stext[0] == '\0')
 		strncpy(stext, "dwl-"VERSION, sizeof(stext));
-	wl_list_for_each(m, &mons, link) {
-		updatebar(m);
-		drawbar(m);
-	}
+	drawbars();
 
 	/* FIXME: figure out why the cursor image is at 0,0 after turning all
 	 * the monitors on.
