+/* Color syntax follows the community barcolors patch by Kerberoge. */
+size_t
+statuscolor(const char *text, uint32_t *scheme)
+{
+	unsigned int i, digit, column;
+	uint32_t color = 0;
+	const char *value;
+
+	if (!strncmp(text, "^fg(", 4))
+		column = ColFg;
+	else if (!strncmp(text, "^bg(", 4))
+		column = ColBg;
+	else
+		return 0;
+
+	value = text + 4;
+	if (*value == ')') {
+		if (scheme)
+			scheme[column] = colors[SchemeNorm][column];
+		return 5;
+	}
+	for (i = 0; i < 6; i++) {
+		if (value[i] >= '0' && value[i] <= '9')
+			digit = (unsigned int)(value[i] - '0');
+		else if (value[i] >= 'a' && value[i] <= 'f')
+			digit = (unsigned int)(value[i] - 'a' + 10);
+		else if (value[i] >= 'A' && value[i] <= 'F')
+			digit = (unsigned int)(value[i] - 'A' + 10);
+		else
+			return 0;
+		color = (color << 4) | digit;
+	}
+	if (value[6] != ')')
+		return 0;
+	if (scheme)
+		scheme[column] = (color << 8) | 0xff;
+	return 11;
+}
+
 int
 statusfeed(const char *text, size_t length)
 {
@@ -3091,10 +3133,43 @@ statusfeed(const char *text, size_t length)
 	return changed;
 }
 
+int
+statuslayout(Monitor *m, int x, int render)
+{
+	char run[sizeof(stext)];
+	const char *p = stext;
+	uint32_t scheme[3];
+	size_t length, command;
+	int width, total = 0;
+
+	memcpy(scheme, colors[SchemeNorm], sizeof(scheme));
+	while (*p) {
+		if ((command = statuscolor(p, scheme))) {
+			p += command;
+			continue;
+		}
+		for (length = 0; p[length] && !statuscolor(p + length, NULL); length++)
+			;
+		memcpy(run, p, length);
+		run[length] = '\0';
+		width = (int)drwl_font_getwidth(m->drw, run);
+		if (render && width) {
+			drwl_setscheme(m->drw, scheme);
+			drwl_text(m->drw, x + total, 0, (unsigned int)width,
+				m->b.height, 0, run, 0);
+		}
+		total += width;
+		p += length;
+	}
+	if (render)
+		drwl_setscheme(m->drw, colors[SchemeNorm]);
+	return total;
+}
+
 int
 statuswidth(Monitor *m)
 {
-	return (int)drwl_font_getwidth(m->drw, stext) + m->statuspad;
+	return statuslayout(m, 0, 0) + m->statuspad;
 }
 
