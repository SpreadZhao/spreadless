From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] input/scroll-factor: scale touchpad finger scroll delta

---
 config.h | 3 +++
 dwl.c    | 4 +++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/config.h b/config.h
index bba8639..6441463 100644
--- a/config.h
+++ b/config.h
@@ -124,6 +124,9 @@ static const int repeat_delay = 600;
 static const int numlock_on = 1;
 
 /* Trackpad */
+#ifndef SDWL_TOUCHPAD_SCROLL_FACTOR
+#define SDWL_TOUCHPAD_SCROLL_FACTOR 1.0
+#endif
 static const int tap_to_click = 1;
 static const int tap_and_drag = 1;
 static const int drag_lock = 1;
diff --git a/dwl.c b/dwl.c
index 9c3d2d3..3ca6c9e 100644
--- a/dwl.c
+++ b/dwl.c
@@ -756,7 +756,9 @@ axisnotify(struct wl_listener *listener, void *data)
 
 	/* Notify the client with pointer focus of the axis event. */
 	wlr_seat_pointer_notify_axis(seat,
-			event->time_msec, event->orientation, event->delta,
+			event->time_msec, event->orientation,
+			event->delta * (event->source == WL_POINTER_AXIS_SOURCE_FINGER
+					? SDWL_TOUCHPAD_SCROLL_FACTOR : 1.0),
 			event->delta_discrete, event->source, event->relative_direction);
 }
 
