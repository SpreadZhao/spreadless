+void
+createtablet(struct wlr_input_device *device)
+{
+	Tablet *tablet = device->data = ecalloc(1, sizeof(*tablet));
+	const TabletRule *rule;
+
+	tablet->tablet = wlr_tablet_create(tablet_mgr, seat, device);
+	for (rule = tabletrules; rule < END(tabletrules); rule++)
+		if (rule->name && !strcmp(rule->name, device->name))
+			tablet->output = rule->output;
+	LISTEN(&device->events.destroy, &tablet->destroy, destroytablet);
+	wlr_cursor_attach_input_device(cursor, device);
+}
