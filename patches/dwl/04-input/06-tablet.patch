+/* Adapted from the dwl tablet-input patch by pi66:
+ * https://codeberg.org/dwl/dwl-patches/src/branch/main/patches/tablet-input */
+TabletTool *
+tablettool(struct wlr_tablet_tool *wlr_tool)
+{
+	TabletTool *tool = wlr_tool->data;
+	if (tool)
+		return tool;
+	tool = wlr_tool->data = ecalloc(1, sizeof(*tool));
+	LISTEN(&wlr_tool->events.destroy, &tool->destroy, destroytablettool);
+	tool->tool = wlr_tablet_tool_create(tablet_mgr, seat, wlr_tool);
+	LISTEN(&tool->tool->events.set_cursor, &tool->set_cursor, settabletcursor);
+	return tool;
+}
+
+void
+tabletcoords(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	TabletCoords *coords = data;
+	struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(buffer);
+	if (surface && surface->surface == coords->surface) {
+		coords->sx = cursor->x - sx;
+		coords->sy = cursor->y - sy;
+		coords->found = 1;
+	}
+}
+
+void
+tabletmotion(Tablet *tablet, TabletTool *tool, uint32_t time,
+		double x, double y, double dx, double dy)
+{
+	Monitor *m;
+	Client *c = NULL;
+	LayerSurface *l = NULL;
+	struct wlr_surface *surface = NULL;
+	struct wlr_input_device *device = tablet->tablet->wlr_device;
+	TabletCoords coords = {0};
+	double sx, sy;
+
+	wlr_idle_notifier_v1_notify_activity(idle_notifier, seat);
+	wlr_cursor_map_input_to_output(cursor, device, NULL);
+	if (tablet->output)
+		wl_list_for_each(m, &mons, link)
+			if (!strcmp(m->wlr_output->name, tablet->output)
+					&& wlr_output_layout_get(output_layout, m->wlr_output)) {
+				wlr_cursor_map_input_to_output(cursor, device, m->wlr_output);
+				break;
+			}
+	if (tool->tool->wlr_tool->type == WLR_TABLET_TOOL_TYPE_MOUSE
+			|| tool->tool->wlr_tool->type == WLR_TABLET_TOOL_TYPE_LENS)
+		wlr_cursor_move(cursor, device, dx, dy);
+	else
+		wlr_cursor_warp_absolute(cursor, device, x, y);
+
+	xytonode(cursor->x, cursor->y, &surface, &c, &l, &sx, &sy);
+	if (locked || tool->pointer_down || !surface
+			|| !wlr_surface_accepts_tablet_v2(surface, tablet->tablet))
+		surface = NULL;
+	if (!locked && wlr_tablet_tool_v2_has_implicit_grab(tool->tool)) {
+		coords.surface = tool->tool->focused_surface;
+		wlr_scene_node_for_each_buffer(&scene->tree.node, tabletcoords, &coords);
+		if (coords.found) {
+			wlr_tablet_v2_tablet_tool_notify_motion(tool->tool, coords.sx, coords.sy);
+			return;
+		}
+	}
+	if (surface != tool->tool->focused_surface) {
+		if (locked && tool->tool->is_down)
+			wlr_tablet_v2_tablet_tool_notify_up(tool->tool);
+		wlr_tablet_v2_tablet_tool_notify_proximity_out(tool->tool);
+		if (surface)
+			wlr_tablet_v2_tablet_tool_notify_proximity_in(tool->tool, tablet->tablet, surface);
+	}
+	if (surface) {
+		if (sloppyfocus) {
+			selmon = xytomon(cursor->x, cursor->y);
+			focusclient(c, 0);
+		}
+		wlr_tablet_v2_tablet_tool_notify_motion(tool->tool, sx, sy);
+	} else {
+		motionnotify(time, NULL, 0, 0, 0, 0);
+		wlr_seat_pointer_notify_frame(seat);
+	}
+}
+
+void
+tabletproximity(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_proximity_event *event = data;
+	TabletTool *tool = tablettool(event->tool);
+
+	wlr_idle_notifier_v1_notify_activity(idle_notifier, seat);
+	if (event->state == WLR_TABLET_TOOL_PROXIMITY_IN) {
+		tabletmotion(event->tablet->base.data, tool, event->time_msec,
+				event->x, event->y, 0, 0);
+	} else {
+		if (tool->pointer_down) {
+			struct wlr_pointer_button_event button = {
+				.time_msec = event->time_msec, .button = BTN_LEFT,
+				.state = WL_POINTER_BUTTON_STATE_RELEASED,
+			};
+			buttonpress(NULL, &button);
+			wlr_seat_pointer_notify_frame(seat);
+			tool->pointer_down = 0;
+		}
+		wlr_tablet_v2_tablet_tool_notify_proximity_out(tool->tool);
+	}
+}
+
+void
+tabletaxis(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_axis_event *event = data;
+	TabletTool *tool = tablettool(event->tool);
+
+	tabletmotion(event->tablet->base.data, tool, event->time_msec,
+			(event->updated_axes & WLR_TABLET_TOOL_AXIS_X) ? event->x : NAN,
+			(event->updated_axes & WLR_TABLET_TOOL_AXIS_Y) ? event->y : NAN,
+			event->dx, event->dy);
+	if (locked || !tool->tool->focused_surface)
+		return;
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_PRESSURE)
+		wlr_tablet_v2_tablet_tool_notify_pressure(tool->tool, event->pressure);
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_DISTANCE)
+		wlr_tablet_v2_tablet_tool_notify_distance(tool->tool, event->distance);
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_TILT_X)
+		tool->tilt_x = event->tilt_x;
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_TILT_Y)
+		tool->tilt_y = event->tilt_y;
+	if (event->updated_axes & (WLR_TABLET_TOOL_AXIS_TILT_X | WLR_TABLET_TOOL_AXIS_TILT_Y))
+		wlr_tablet_v2_tablet_tool_notify_tilt(tool->tool, tool->tilt_x, tool->tilt_y);
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_ROTATION)
+		wlr_tablet_v2_tablet_tool_notify_rotation(tool->tool, event->rotation);
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_SLIDER)
+		wlr_tablet_v2_tablet_tool_notify_slider(tool->tool, event->slider);
+	if (event->updated_axes & WLR_TABLET_TOOL_AXIS_WHEEL)
+		wlr_tablet_v2_tablet_tool_notify_wheel(tool->tool, event->wheel_delta, 0);
+}
+
+void
+tabletbutton(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_button_event *event = data;
+	TabletTool *tool = tablettool(event->tool);
+	struct wlr_pointer_button_event button = {
+		.time_msec = event->time_msec,
+		.button = event->button == BTN_STYLUS ? BTN_RIGHT : BTN_MIDDLE,
+		.state = event->state == WLR_BUTTON_PRESSED ?
+			WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED,
+	};
+
+	tabletmotion(event->tablet->base.data, tool, event->time_msec, NAN, NAN, 0, 0);
+	if (!locked && tool->tool->focused_surface)
+		wlr_tablet_v2_tablet_tool_notify_button(tool->tool, event->button,
+				(enum zwp_tablet_pad_v2_button_state)event->state);
+	else {
+		buttonpress(NULL, &button);
+		wlr_seat_pointer_notify_frame(seat);
+	}
+}
+
+void
+tablettip(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_tip_event *event = data;
+	TabletTool *tool = tablettool(event->tool);
+	Client *c = NULL;
+	struct wlr_pointer_button_event button = {
+		.time_msec = event->time_msec, .button = BTN_LEFT,
+		.state = event->state == WLR_TABLET_TOOL_TIP_DOWN ?
+			WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED,
+	};
+
+	tabletmotion(event->tablet->base.data, tool, event->time_msec,
+			event->x, event->y, 0, 0);
+	if (tool->pointer_down || locked || !tool->tool->focused_surface) {
+		buttonpress(NULL, &button);
+		wlr_seat_pointer_notify_frame(seat);
+		tool->pointer_down = event->state == WLR_TABLET_TOOL_TIP_DOWN;
+	} else if (event->state == WLR_TABLET_TOOL_TIP_DOWN) {
+		xytonode(cursor->x, cursor->y, NULL, &c, NULL, NULL, NULL);
+		focusclient(c, 1);
+		wlr_tablet_v2_tablet_tool_notify_down(tool->tool);
+		wlr_tablet_tool_v2_start_implicit_grab(tool->tool);
+	} else {
+		wlr_tablet_v2_tablet_tool_notify_up(tool->tool);
+	}
+}
+
 void
 tile(Monitor *m)
 {
