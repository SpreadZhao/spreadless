From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eldar Yusupov <eyusupov@gmail.com>
Date: Sat, 31 Oct 2026 16:44:21 +0800
Subject: [PATCH] monitor/restore-monitor: restore windows after output
 reconnection

Adapt the restore-monitor community patch to dwl 0.9 and wlroots 0.20.
Keep output ownership separate from temporary fallback placement, restore
floating geometry and the selected tag view, and update ownership for both
keyboard and mouse moves.

Original patch: Eldar Yusupov <eyusupov@gmail.com>
Community maintenance: 6z7y
Source: https://codeberg.org/dwl/dwl-patches/src/branch/main/patches/restore-monitor
---
 dwl.c | 59 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 56 insertions(+), 3 deletions(-)

diff --git a/dwl.c b/dwl.c
index 65356a9..3f38976 100644
--- a/dwl.c
+++ b/dwl.c
@@ -132,6 +132,10 @@ typedef struct {
 	unsigned int type; /* XDGShell or X11* */
 
 	Monitor *mon;
+	char *output;
+	struct wlr_box floatgeom, prevgeom;
+	uint32_t restoreview;
+	int restoring;
 	struct wlr_scene_tree *scene;
 	struct wlr_scene_rect *border[4]; /* top, bottom, left, right */
 	struct wlr_scene_tree *scene_surface;
@@ -395,6 +399,7 @@ static void locksession(struct wl_listener *listener, void *data);
 static void mapnotify(struct wl_listener *listener, void *data);
 static void maximizenotify(struct wl_listener *listener, void *data);
 static void monocle(Monitor *m);
+static void migratemon(Client *c, Monitor *m, uint32_t newtags);
 static void motionabsolute(struct wl_listener *listener, void *data);
 static void motionnotify(uint32_t time, struct wlr_input_device *device, double sx,
 		double sy, double sx_unaccel, double sy_unaccel);
@@ -412,6 +417,7 @@ static void requestdecorationmode(struct wl_listener *listener, void *data);
 static void requeststartdrag(struct wl_listener *listener, void *data);
 static void requestmonstate(struct wl_listener *listener, void *data);
 static void resize(Client *c, struct wlr_box geo, int interact);
+static void restoremon(Monitor *m);
 static void run(char *startup_cmd);
 static void setborderwidth(Client *c, unsigned int bw);
 static void setcursor(struct wl_listener *listener, void *data);
@@ -1144,11 +1150,20 @@ closemon(Monitor *m)
 	}
 
 	wl_list_for_each(c, &clients, link) {
+		if (c->mon != m)
+			continue;
+		c->floatgeom = c->geom;
+		c->floatgeom.x -= m->m.x;
+		c->floatgeom.y -= m->m.y;
+		c->prevgeom = c->prev;
+		c->prevgeom.x -= m->m.x;
+		c->prevgeom.y -= m->m.y;
+		c->restoreview = m->tagset[m->seltags];
+		c->restoring = 1;
 		if (c->isfloating && c->geom.x > m->m.width)
 			resize(c, (struct wlr_box){.x = c->geom.x - m->w.width, .y = c->geom.y,
 					.width = c->geom.width, .height = c->geom.height}, 0);
-		if (c->mon == m)
-			setmon(c, selmon, c->tags);
+		migratemon(c, selmon, c->tags);
 	}
 	focusclient(focustop(selmon), 1);
 	drawbars();
@@ -1779,6 +1794,7 @@ destroynotify(struct wl_listener *listener, void *data)
 			wl_list_remove(&c->destroy_decoration.link);
 		}
 	}
+	free(c->output);
 	free(c);
 }
 
@@ -2960,7 +2976,7 @@ setmfact(const Arg *arg)
 }
 
 void
-setmon(Client *c, Monitor *m, uint32_t newtags)
+migratemon(Client *c, Monitor *m, uint32_t newtags)
 {
 	Monitor *oldmon = c->mon;
 
@@ -2982,6 +2998,43 @@ setmon(Client *c, Monitor *m, uint32_t newtags)
 	focusclient(focustop(selmon), 1);
 }
 
+/* Adapted from restore-monitor by Eldar Yusupov and 6z7y:
+ * https://codeberg.org/dwl/dwl-patches/src/branch/main/patches/restore-monitor */
+void
+restoremon(Monitor *m)
+{
+	Client *c;
+	struct wlr_box geom;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!c->restoring || !c->output || strcmp(c->output, m->wlr_output->name))
+			continue;
+		m->tagset[m->seltags] = c->restoreview;
+		migratemon(c, m, c->tags);
+		if (c->isfloating && !c->isfullscreen) {
+			geom = c->floatgeom;
+			geom.x += m->m.x;
+			geom.y += m->m.y;
+			resize(c, geom, 0);
+		}
+		c->prev = c->prevgeom;
+		c->prev.x += m->m.x;
+		c->prev.y += m->m.y;
+		c->restoring = 0;
+	}
+}
+
+void
+setmon(Client *c, Monitor *m, uint32_t newtags)
+{
+	free(c->output);
+	c->output = NULL;
+	if (m && !(c->output = strdup(m->wlr_output->name)))
+		die("strdup:");
+	c->restoring = 0;
+	migratemon(c, m, newtags);
+}
+
