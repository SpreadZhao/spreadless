From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] monitor/output-move: keep floating window offsets when
 outputs move

Shift floating and saved window geometries when an output profile moves an
active monitor in the layout.
---
 dwl.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/dwl.c b/dwl.c
index 512da6f..ca1bd19 100644
--- a/dwl.c
+++ b/dwl.c
@@ -3852,6 +3852,7 @@ updatemons(struct wl_listener *listener, void *data)
 	Client *c;
 	struct wlr_output_configuration_head_v1 *config_head;
 	Monitor *m;
+	struct wlr_box oldgeom, geom;
 
 	/* First remove from the layout the disabled monitors */
 	wl_list_for_each(m, &mons, link) {
@@ -3892,6 +3893,7 @@ updatemons(struct wl_listener *listener, void *data)
 		config_head = wlr_output_configuration_head_v1_create(config, m->wlr_output);
 
 		/* Get the effective monitor geometry to use for surfaces */
+		oldgeom = m->m;
 		wlr_output_layout_get_box(output_layout, m->wlr_output, &m->m);
 		m->w = m->m;
 		wlr_scene_output_set_position(m->scene_output, m->m.x, m->m.y);
@@ -3907,6 +3909,23 @@ updatemons(struct wl_listener *listener, void *data)
 
 		/* Calculate the effective monitor geometry to use for clients */
 		arrangelayers(m);
+		/* Keep floating offsets when an output profile moves the monitor. */
+		if (oldgeom.width && oldgeom.height
+				&& (oldgeom.x != m->m.x || oldgeom.y != m->m.y)) {
+			wl_list_for_each(c, &clients, link) {
+				if (c->mon != m)
+					continue;
+				c->prev.x += m->m.x - oldgeom.x;
+				c->prev.y += m->m.y - oldgeom.y;
+				if (c->isfloating && !c->isfullscreen) {
+					geom = c->geom;
+					geom.x += m->m.x - oldgeom.x;
+					geom.y += m->m.y - oldgeom.y;
+					resize(c, geom, 0);
+				}
+			}
+		}
+		restoremon(m);
 		/* Don't move clients to the left output when plugging monitors */
 		arrange(m);
 		/* make sure fullscreen clients have the right size */
