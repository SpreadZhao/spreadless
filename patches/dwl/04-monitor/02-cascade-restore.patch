From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] monitor/cascade-restore: preserve original output across
 cascading disconnects

Keep each window'\''s original connector and saved geometry when multiple
outputs disconnect and reconnect in sequence.
---
 dwl.c | 27 +++++++++++++++++----------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/dwl.c b/dwl.c
index 8ce57a9..512da6f 100644
--- a/dwl.c
+++ b/dwl.c
@@ -1152,14 +1152,17 @@ closemon(Monitor *m)
 	wl_list_for_each(c, &clients, link) {
 		if (c->mon != m)
 			continue;
-		c->floatgeom = c->geom;
-		c->floatgeom.x -= m->m.x;
-		c->floatgeom.y -= m->m.y;
-		c->prevgeom = c->prev;
-		c->prevgeom.x -= m->m.x;
-		c->prevgeom.y -= m->m.y;
-		c->restoreview = m->tagset[m->seltags];
-		c->restoring = 1;
+		/* Keep the original output through successive disconnections. */
+		if (!c->restoring) {
+			c->floatgeom = c->geom;
+			c->floatgeom.x -= m->m.x;
+			c->floatgeom.y -= m->m.y;
+			c->prevgeom = c->prev;
+			c->prevgeom.x -= m->m.x;
+			c->prevgeom.y -= m->m.y;
+			c->restoreview = m->tagset[m->seltags];
+			c->restoring = 1;
+		}
 		if (c->isfloating && c->geom.x > m->m.width)
 			resize(c, (struct wlr_box){.x = c->geom.x - m->w.width, .y = c->geom.y,
 					.width = c->geom.width, .height = c->geom.height}, 0);
@@ -3924,8 +3927,12 @@ updatemons(struct wl_listener *listener, void *data)
 
 	if (selmon && selmon->wlr_output->enabled) {
 		wl_list_for_each(c, &clients, link) {
-			if (!c->mon && client_surface(c)->mapped)
-				setmon(c, selmon, c->tags);
+			if (!c->mon && client_surface(c)->mapped) {
+				if (c->output)
+					migratemon(c, selmon, c->tags);
+				else
+					setmon(c, selmon, c->tags);
+			}
 		}
 		focusclient(focustop(selmon), 1);
 		if (selmon->lock_surface) {
