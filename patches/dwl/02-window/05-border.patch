From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] window/border: keep client content size stable across focus
 changes

Reserve the smaller configured border width in both focus states and draw
any extra border width over the inner window edge so focus changes keep
client content size and position unchanged without leaving gaps between
windows. Pass pointer hit-testing through overlaid border rectangles to the
client surface underneath. Fullscreen windows reserve no border space.
---
 config.def.h |  3 ++-
 dwl.c        | 44 +++++++++++++++++++++++++++++++++-----------
 2 files changed, 35 insertions(+), 12 deletions(-)

diff --git a/config.def.h b/config.def.h
index d0edbd7..e75e84a 100644
--- a/config.def.h
+++ b/config.def.h
@@ -6,7 +6,8 @@
 /* appearance */
 static const int sloppyfocus               = 0;  /* focus follows mouse */
 static const int bypass_surface_visibility = 0;  /* 1 means idle inhibitors will disable idle tracking even if it's surface isn't visible  */
-static const unsigned int borderpx         = 1;  /* border pixel of windows */
+static const unsigned int borderpx         = 2; /* visible border width when focused */
+static const unsigned int unfocused_borderpx = 0;
 static const unsigned int snap             = 32; /* snap pixel */
 static const int showbar                   = 1; /* 0 means no bar */
 static const int topbar                    = 1; /* 0 means bottom bar */
diff --git a/dwl.c b/dwl.c
index bb0ed26..96f30e4 100644
--- a/dwl.c
+++ b/dwl.c
@@ -385,6 +385,7 @@ static void requeststartdrag(struct wl_listener *listener, void *data);
 static void requestmonstate(struct wl_listener *listener, void *data);
 static void resize(Client *c, struct wlr_box geo, int interact);
 static void run(char *startup_cmd);
+static void setborderwidth(Client *c, unsigned int bw);
 static void setcursor(struct wl_listener *listener, void *data);
 static void setcursorshape(struct wl_listener *listener, void *data);
 static void setfloating(Client *c, int floating);
@@ -1423,7 +1424,7 @@ createnotify(struct wl_listener *listener, void *data)
 	/* Allocate a Client for this surface */
 	c = toplevel->base->data = ecalloc(1, sizeof(*c));
 	c->surface.xdg = toplevel->base;
-	c->bw = borderpx;
+	c->bw = MIN(borderpx, unfocused_borderpx);
 
 	LISTEN(&toplevel->base->surface->events.commit, &c->commit, commitnotify);
 	LISTEN(&toplevel->base->surface->events.map, &c->map, mapnotify);
@@ -1886,6 +1887,7 @@ focusclient(Client *c, int lift)
 		struct wlr_surface *s = client_surface(focused_client);
 		if (c)
 			client_set_border_color(focused_client, (float[])COLOR(colors[SchemeNorm][ColBorder]));
+		setborderwidth(focused_client, unfocused_borderpx);
 		if (s && s->mapped)
 			client_activate_surface(s, 0);
 		focused_client = NULL;
@@ -1910,8 +1912,10 @@ focusclient(Client *c, int lift)
 	/* Activate the new client */
 	client_activate_surface(client_surface(c), 1);
 
-	if (!client_is_unmanaged(c))
+	if (!client_is_unmanaged(c)) {
 		focused_client = c;
+		setborderwidth(c, borderpx);
+	}
 }
 
 void
@@ -2224,6 +2228,7 @@ mapnotify(struct wl_listener *listener, void *data)
 		goto unset_fullscreen;
 	}
 
+	c->bw = c->isfullscreen ? 0 : MIN(borderpx, unfocused_borderpx);
 	for (i = 0; i < 4; i++) {
 		c->border[i] = wlr_scene_rect_create(c->scene, 0, 0,
 			(float[])COLOR(colors[c->isurgent ? SchemeUrg : SchemeNorm][ColBorder]));
@@ -2669,13 +2674,7 @@ resize(Client *c, struct wlr_box geo, int interact)
 	/* Update scene-graph, including borders */
 	wlr_scene_node_set_position(&c->scene->node, c->geom.x, c->geom.y);
 	wlr_scene_node_set_position(&c->scene_surface->node, c->bw, c->bw);
-	wlr_scene_rect_set_size(c->border[0], c->geom.width, c->bw);
-	wlr_scene_rect_set_size(c->border[1], c->geom.width, c->bw);
-	wlr_scene_rect_set_size(c->border[2], c->bw, c->geom.height - 2 * c->bw);
-	wlr_scene_rect_set_size(c->border[3], c->bw, c->geom.height - 2 * c->bw);
-	wlr_scene_node_set_position(&c->border[1]->node, 0, c->geom.height - c->bw);
-	wlr_scene_node_set_position(&c->border[2]->node, 0, c->bw);
-	wlr_scene_node_set_position(&c->border[3]->node, c->geom.width - c->bw, c->bw);
+	setborderwidth(c, c == focused_client ? borderpx : unfocused_borderpx);
 
 	client_set_size(c, c->geom.width - 2 * c->bw, c->geom.height - 2 * c->bw);
 	client_get_clip(c, &clip);
@@ -2728,6 +2727,23 @@ run(char *startup_cmd)
 	wl_display_run(dpy);
 }
 
+void
+setborderwidth(Client *c, unsigned int bw)
+{
+	int sideh;
+
+	/* Keep border space fixed so focus changes do not resize content. */
+	bw = c->isfullscreen ? 0 : bw;
+	sideh = MAX(0, c->geom.height - 2 * (int)bw);
+	wlr_scene_rect_set_size(c->border[0], c->geom.width, bw);
+	wlr_scene_rect_set_size(c->border[1], c->geom.width, bw);
+	wlr_scene_rect_set_size(c->border[2], bw, sideh);
+	wlr_scene_rect_set_size(c->border[3], bw, sideh);
+	wlr_scene_node_set_position(&c->border[1]->node, 0, c->geom.height - bw);
+	wlr_scene_node_set_position(&c->border[2]->node, 0, bw);
+	wlr_scene_node_set_position(&c->border[3]->node, c->geom.width - bw, bw);
+}
+
 void
 setcursor(struct wl_listener *listener, void *data)
 {
@@ -2783,7 +2799,7 @@ setfullscreen(Client *c, int fullscreen)
 	c->isfullscreen = fullscreen;
 	if (!c->mon || !client_surface(c)->mapped)
 		return;
-	c->bw = fullscreen ? 0 : borderpx;
+	c->bw = fullscreen ? 0 : MIN(borderpx, unfocused_borderpx);
 	client_set_fullscreen(c, fullscreen);
 	wlr_scene_node_reparent(&c->scene->node, layers[c->isfullscreen
 			? LyrFS : c->isfloating ? LyrFloat : LyrTile]);
@@ -3696,6 +3712,12 @@ xytonode(double x, double y, struct wlr_surface **psurface,
 				!(node = wlr_scene_node_at(&layers[layer]->node, x, y, nx, ny)))
 			continue;
 
+		if (node->type == WLR_SCENE_NODE_RECT && node->data) {
+			Client *c = node->data;
+			node = wlr_scene_node_at(&c->scene_surface->node, x, y, nx, ny);
+			if (!node)
+				continue;
+		}
 		if (node->type == WLR_SCENE_NODE_BUFFER) {
 			scene_surface = wlr_scene_surface_try_from_buffer(
 					wlr_scene_buffer_from_node(node));
@@ -3792,7 +3814,7 @@ createnotifyx11(struct wl_listener *listener, void *data)
 	c = xsurface->data = ecalloc(1, sizeof(*c));
 	c->surface.xwayland = xsurface;
 	c->type = X11;
-	c->bw = client_is_unmanaged(c) ? 0 : borderpx;
+	c->bw = client_is_unmanaged(c) ? 0 : MIN(borderpx, unfocused_borderpx);
 
 	/* Listen to the various events it can emit */
 	LISTEN(&xsurface->events.associate, &c->associate, associatex11);
