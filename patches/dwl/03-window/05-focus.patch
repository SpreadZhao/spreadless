From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SpreadZhao <spreadzhao@outlook.com>
Date: Thu, 29 Oct 2026 12:18:32 +0800
Subject: [PATCH] window/focus: disable sloppy focus and follow windows across
 outputs

---
 config.h | 2 +-
 dwl.c    | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/config.h b/config.h
index 36112a9..34ff718 100644
--- a/config.h
+++ b/config.h
@@ -47,7 +47,7 @@
                         ((hex >> 8) & 0xFF) / 255.0f, \
                         (hex & 0xFF) / 255.0f }
 /* appearance */
-static const int sloppyfocus               = 1;  /* focus follows mouse */
+static const int sloppyfocus               = 0;  /* focus follows mouse */
 static const int bypass_surface_visibility = 0;  /* 1 means idle inhibitors will disable idle tracking even if it's surface isn't visible  */
 static const unsigned int borderpx         = 1;  /* border pixel of windows */
 static const unsigned int snap             = 32; /* snap pixel */
diff --git a/dwl.c b/dwl.c
index 12dff2a..b2efacc 100644
--- a/dwl.c
+++ b/dwl.c
@@ -3293,8 +3293,10 @@ void
 tagmon(const Arg *arg)
 {
 	Client *sel = focustop(selmon);
-	if (sel)
+	if (sel) {
 		setmon(sel, dirtomon(arg->i), 0);
+		focusclient(sel, 1);
+	}
 }
 
 void
